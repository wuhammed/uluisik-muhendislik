---
// Tek hat şeması motifi: bara, kesici ve hat düğümleri. `.flow` sınıfı
// hatların üzerinde akan "akım" nabzını canlandırır (reduced-motion'da durur).
---

<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="hv-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f8d34a" stop-opacity="0.6"></stop>
        <stop offset="1" stop-color="#d9930b" stop-opacity="0.16"></stop>
      </linearGradient>
    </defs>
    <g stroke="url(#hv-gold)" stroke-width="1.5" fill="none" opacity="0.55">
      <path d="M-20 560 H300 L370 490 H620 L690 420 H1220"></path>
      <path d="M-20 460 H220 L290 390 H520 L600 310 H860 L930 240 H1220"></path>
      <path d="M160 700 V560 L230 490"></path>
      <path d="M760 700 V590 L830 520 H1050"></path>
      <path d="M480 0 V120 L560 200 H800 L870 270"></path>
      <path d="M1010 0 V90 L940 160"></path>
    </g>
    <g stroke="#f5c51b" stroke-width="2" fill="none" stroke-linecap="round">
      <path class="flow" d="M-20 560 H300 L370 490 H620 L690 420 H1220"></path>
      <path class="flow" style="animation-delay: -2.2s" d="M-20 460 H220 L290 390 H520 L600 310 H860 L930 240 H1220"></path>
      <path class="flow" style="animation-delay: -3.8s" d="M480 0 V120 L560 200 H800 L870 270"></path>
    </g>
    <g fill="#f5c51b">
      <circle cx="300" cy="560" r="4.5" opacity="0.85"></circle>
      <circle cx="620" cy="490" r="4.5" opacity="0.6"></circle>
      <circle cx="520" cy="390" r="4.5" opacity="0.75"></circle>
      <circle cx="860" cy="310" r="4.5" opacity="0.55"></circle>
      <circle cx="800" cy="200" r="4.5" opacity="0.65"></circle>
      <circle cx="230" cy="490" r="4.5" opacity="0.7"></circle>
      <circle cx="1050" cy="520" r="4.5" opacity="0.5"></circle>
    </g>
  </svg>
</div>

<style>
  .hero-visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--hero-glow);
  }

  .hero-visual svg {
    width: 100%;
    height: 100%;
  }
</style>
