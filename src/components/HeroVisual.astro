---
// Hero arka planı: soyut devre hattı motifi + altın parıltı.
---

<div class="hero-visual" aria-hidden="true">
  <svg viewBox="0 0 800 600" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="hv-gold" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f5c51b" stop-opacity="0.55"></stop>
        <stop offset="1" stop-color="#d99a0b" stop-opacity="0.15"></stop>
      </linearGradient>
    </defs>
    <g stroke="url(#hv-gold)" stroke-width="1.5" fill="none">
      <path d="M40 520 H240 L300 460 H460 L520 400 H760"></path>
      <path d="M0 420 H180 L240 360 H400 L470 290 H640 L700 230 H800"></path>
      <path d="M120 600 V480 L180 420"></path>
      <path d="M560 600 V500 L620 440 H760"></path>
      <path d="M340 0 V90 L400 150 H560 L620 210"></path>
      <path d="M700 0 V70 L640 130"></path>
    </g>
    <g fill="#f5c51b">
      <circle cx="240" cy="520" r="4" opacity="0.8"></circle>
      <circle cx="460" cy="460" r="4" opacity="0.6"></circle>
      <circle cx="400" cy="360" r="4" opacity="0.7"></circle>
      <circle cx="640" cy="290" r="4" opacity="0.5"></circle>
      <circle cx="560" cy="150" r="4" opacity="0.6"></circle>
      <circle cx="180" cy="420" r="4" opacity="0.7"></circle>
    </g>
    <path d="M430 180 380 260h32l-18 70 66-90h-34l24-60z" fill="url(#hv-gold)"></path>
  </svg>
</div>

<style>
  .hero-visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--hero-glow);
  }

  .hero-visual svg {
    width: 100%;
    height: 100%;
    opacity: 0.5;
  }
</style>
