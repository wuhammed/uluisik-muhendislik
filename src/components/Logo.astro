---
import { SITE, withBase } from '../data/site';
import LogoMark from './LogoMark.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<a href={withBase('/')} class:list={['logo', { compact }]} aria-label={`${SITE.name} — ana sayfa`}>
  <LogoMark size={compact ? 40 : 48} />
  <span class="logo-text">
    <span class="logo-name gold-text">ULUIŞIK MÜHENDİSLİK</span>
    <span class="logo-tagline">{SITE.tagline}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: inherit;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    line-height: 1.18;
  }

  .logo-name {
    font-family: 'Sora Variable', sans-serif;
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .logo-tagline {
    font-size: 0.66rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .compact .logo-name {
    font-size: 0.9rem;
  }

  @media (max-width: 420px) {
    .logo-tagline {
      display: none;
    }

    .logo-name {
      font-size: 0.85rem;
    }
  }
</style>
