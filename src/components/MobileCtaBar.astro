---
import BrandIcons from './BrandIcons.astro';
import { SITE } from '../data/site';
---

<div class="mobile-cta" role="navigation" aria-label="Hızlı iletişim">
  <a class="btn btn-gold" href={SITE.phoneHref}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
    </svg>
    Hemen Ara
  </a>
  <a class="btn btn-whatsapp" href={SITE.whatsappHref} rel="noopener">
    <BrandIcons name="whatsapp" size={20} />
    WhatsApp
  </a>
</div>

<style>
  .mobile-cta {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem calc(0.6rem + env(safe-area-inset-bottom));
    background: var(--header-bg);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--line-soft);
  }

  .mobile-cta .btn {
    flex: 1;
    justify-content: center;
    padding: 0.7rem 0.5rem;
    font-size: 0.95rem;
  }

  @media (min-width: 768px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
