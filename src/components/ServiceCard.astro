---
interface Props {
  title: string;
  summary: string;
  href: string;
  icon: 'plan' | 'meter' | 'dig' | 'panel' | 'consult';
}

const { title, summary, href, icon } = Astro.props;
---

<a class="card service-card" href={href}>
  <span class="service-icon">
    {icon === 'plan' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <path d="M3 9h18M9 21V9"></path>
        <path d="m14 13 2 2-2 2"></path>
      </svg>
    )}
    {icon === 'meter' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 3"></path>
      </svg>
    )}
    {icon === 'dig' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m3 21 6-6"></path>
        <path d="M9 15 20 4a1.5 1.5 0 0 0-2-2L7 13"></path>
        <path d="M6 12 3 15v6h6l3-3"></path>
      </svg>
    )}
    {icon === 'panel' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="2" width="16" height="20" rx="2"></rect>
        <path d="M8 6h8M8 10h8"></path>
        <path d="m12.5 13.5-2 3.5h3l-2 3.5"></path>
      </svg>
    )}
    {icon === 'consult' && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <path d="M14 2v6h6"></path>
        <path d="M9 15h6M9 11h2"></path>
      </svg>
    )}
  </span>
  <h3>{title}</h3>
  <p class="muted">{summary}</p>
  <span class="service-more">Detaylı bilgi →</span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    color: inherit;
  }

  .service-icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--gold-gradient);
    color: var(--accent-ink);
    margin-bottom: 1.1rem;
  }

  .service-icon svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .service-card p {
    flex: 1;
    font-size: 0.95rem;
  }

  .service-more {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
</style>
