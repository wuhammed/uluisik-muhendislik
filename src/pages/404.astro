---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
---

<BaseLayout title="Sayfa Bulunamadı" description="Aradığınız sayfa bulunamadı.">
  <section class="section notfound">
    <div class="container">
      <p class="code gold-text">404</p>
      <h1>Sayfa Bulunamadı</h1>
      <p class="muted">Aradığınız sayfa taşınmış veya hiç var olmamış olabilir.</p>
      <div class="actions">
        <a class="btn btn-gold" href={withBase('/')}>Ana Sayfaya Dön</a>
        <a class="btn btn-outline" href={withBase('/iletisim')}>İletişime Geç</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: 7rem;
  }

  .code {
    font-family: 'Sora Variable', sans-serif;
    font-size: 5rem;
    font-weight: 700;
    margin: 0;
    line-height: 1;
  }

  .actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
