---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ServiceCard from '../components/ServiceCard.astro';
import BrandIcons from '../components/BrandIcons.astro';
import { SITE } from '../data/site';
import { SERVICES, WHY_US } from '../data/services';
import heroImg from '../assets/hero-tower.jpg';

const icons = ['plan', 'meter', 'dig', 'panel', 'consult'] as const;
---

<BaseLayout
  title={SITE.name}
  description="Samsun'da AG ve YG elektrik projelendirme, elektrik abonelik işlemleri, altyapı-kazı çalışmaları ve elektrik taahhüt hizmetleri. Projeden uygulamaya tek noktadan çözüm."
  isHome
>
  <section class="hero">
    <Image
      src={heroImg}
      alt=""
      class="hero-img"
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-overlay" aria-hidden="true"></div>
    <HeroVisual />
    <div class="container hero-content">
      <span class="eyebrow">{SITE.tagline}</span>
      <h1>{SITE.slogan}</h1>
      <p class="muted hero-sub">
        AG ve YG elektrik projelendirme, abonelik işlemleri, enerji altyapısı ve elektrik
        taahhüt hizmetlerinde; keşiften enerji bağlantısına kadar tüm süreci tek noktadan
        yönetiyoruz.
      </p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={SITE.phoneHref}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          {SITE.phoneDisplay}
        </a>
        <a class="btn btn-whatsapp" href={SITE.whatsappHref} rel="noopener">
          <BrandIcons name="whatsapp" size={20} />
          WhatsApp'tan Yazın
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Firmamız</span>
      <h2>Elektrik Mühendisliği ve Taahhüt Hizmetleri</h2>
      <hr class="divider" />
      <p class="muted intro-text">
        Elektrik mühendisliği alanında faaliyet gösteren firmamız; konut, ticari yapılar,
        sanayi tesisleri ve farklı nitelikteki projelerin elektrik ihtiyaçlarını yürürlükteki
        mevzuat, teknik standartlar ve dağıtım şirketi şartlarına uygun şekilde projelendiriyor
        ve uyguluyoruz. Projenin ilk aşamasından enerji bağlantısının gerçekleştirilmesine
        kadar olan süreçte; keşif, projelendirme, resmi başvuru ve onay süreçleri, abonelik
        işlemleri, altyapı ve kazı çalışmaları ile elektrik uygulamalarını bir bütün olarak
        ele alıyoruz.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Uzmanlık Alanlarımız</span>
      <h2>Baştan Sona Elektrik Çözümleri</h2>
      <hr class="divider" />
      <div class="grid grid-3 services-grid">
        {
          SERVICES.map((s, i) => (
            <ServiceCard
              title={s.title}
              summary={s.summary}
              href={`/hizmetler#${s.slug}`}
              icon={icons[i]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <span class="eyebrow">Neden Biz?</span>
      <h2>Mühendislik Disiplini, Teknik Doğruluk</h2>
      <hr class="divider" />
      <ul class="why-list">
        {
          WHY_US.map((item) => (
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5"></path>
              </svg>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section cta-strip">
    <div class="container cta-inner">
      <div>
        <h2>Projeniz için bugün görüşelim</h2>
        <p class="muted">
          Keşif, projelendirme ve abonelik süreçleriniz için bize ulaşın; ihtiyacınıza özel
          çözümü birlikte planlayalım.
        </p>
      </div>
      <div class="cta-actions">
        <a class="btn btn-gold" href={SITE.phoneHref}>{SITE.phoneDisplay}</a>
        <a class="btn btn-whatsapp" href={SITE.whatsappHref} rel="noopener">
          <BrandIcons name="whatsapp" size={20} />
          WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background: #0e1116;
    border-bottom: 1px solid var(--line-soft);
    overflow: hidden;
  }

  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 17, 22, 0.82), rgba(14, 17, 22, 0.68) 55%, rgba(14, 17, 22, 0.88));
  }

  /* Hero fotoğraf üstünde her iki temada da açık renk metin kullanır */
  .hero-content {
    position: relative;
    padding-block: clamp(4rem, 10vw, 7.5rem);
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    color: #f2f4f8;
  }

  .hero-sub {
    font-size: 1.1rem;
    max-width: 56ch;
    margin-inline: auto;
    color: #b8bec9;
  }

  .hero-content :global(.eyebrow) {
    color: #f5c51b;
  }

  .hero-actions {
    display: flex;
    gap: 0.9rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .intro-text {
    max-width: 75ch;
  }

  .services-grid {
    margin-top: 2rem;
  }

  .why-list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  @media (min-width: 700px) {
    .why-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .why-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-weight: 500;
  }

  .why-list svg {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.2rem;
    color: var(--accent);
  }

  .cta-strip {
    background: var(--bg-raised);
    border-block: 1px solid var(--line-soft);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .cta-inner h2 {
    margin-bottom: 0.4rem;
  }

  .cta-inner p {
    margin: 0;
    max-width: 52ch;
  }

  .cta-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
</style>
